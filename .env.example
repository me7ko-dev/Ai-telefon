# Копирай този файл като .env и смени стойностите.

# Парола за вход в панела
ADMIN_PASSWORD=smeni-me

# Таен ключ за бисквитките на панела (дълъг случаен низ)
# Генериране: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=smeni-me-s-dalag-sluchaen-niz

# Таен ключ, който ElevenLabs праща в заглавката X-Tool-Secret към инструментите
TOOL_SECRET=smeni-me-tool-secret

# База данни (SQLite файл)
DATABASE_URL=sqlite:///./data/app.db

# Фирма, която панелът управлява (в етап 4 ще идва от акаунта)
PANEL_BUSINESS_SLUG=demo

# Създай демо фирма с примерни данни, ако базата е празна
SEED_DEMO=true

# Публичен адрес на API-то (Cloudflare Tunnel) – ползва се само за показване на URL-ите в панела
PUBLIC_BASE_URL=http://localhost:8000
